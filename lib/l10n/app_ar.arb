  "languageArabic": "العربية",
  "@languageArabic": {
    "description": "LANG-1. Arabic, written in its own language; the same in every message file."
  },

  "historyHeaderToday": "اليوم",
  "@historyHeaderToday": {
    "description": "DATE-2, HIS-3. Date header for rows from the current local calendar day."
  },
  "historyHeaderYesterday": "أمس",
  "@historyHeaderYesterday": {
    "description": "DATE-2, HIS-3. Date header for rows from the previous local calendar day."
  },
  "historyHeaderWeekday": "{date}",
  "@historyHeaderWeekday": {
    "description": "DATE-2, HIS-3, LANG-3. Date header for rows from the last 7 days: the weekday name in the app language.",
    "placeholders": {
      "date": {
        "type": "DateTime",
        "format": "EEEE",
        "example": "Monday"
      }
    }
  },
  "historyHeaderDate": "{date}",
  "@historyHeaderDate": {
    "description": "DATE-2, HIS-3, LANG-3. Date header for older rows: the local calendar day formatted for the app language.",
    "placeholders": {
      "date": {
        "type": "DateTime",
        "format": "yMMMMd",
        "example": "September 17, 2026"
      }
    }
  },
  "historySeenCount": "×{count}",
  "@historySeenCount": {
    "description": "HIS-4, LANG-3. Shown on a history row when the code was seen 2 or more times; the number follows the app language.",
    "placeholders": {
      "count": {
        "type": "int",
        "format": "decimalPattern",
        "example": "3"
      }
    }
  },
  "historyCodeCount": "{count, plural, zero{لا رموز} one{رمز واحد} two{رمزان} few{{count} رموز} many{{count} رمزًا} other{{count} رمز}}",
  "@historyCodeCount": {
    "description": "HIS-6, DATA-8. A count of codes, used for a saved batch row and for empty states.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "5"
      }
    }
  },

  "copiedSnackbar": "تم نسخ {what}",
  "@copiedSnackbar": {
    "description": "SET-3, RES-2. Snackbar confirming what was copied. The placeholder takes an already translated noun, such as the link or the password.",
    "placeholders": {
      "what": {
        "type": "String",
        "example": "the link"
      }
    }
  },

  "errorStorageUnavailable": "لا يمكن للتطبيق فتح مساحة التخزين. أغلق التطبيق ثم افتحه من جديد.",
  "@errorStorageUnavailable": {
    "description": "LANG-2. Fills the screen when the app database will not open at launch, so the app says what happened instead of crashing or showing a blank frame. Not errorSaveFailed: nothing was being saved."
  },
  "errorSaveFailed": "لم يتم حفظ أي شيء. حاول مرة أخرى.",
  "@errorSaveFailed": {
    "description": "Reliable writes: shown when a write fails and the change was rolled back, so no partial record is left."
  },
  "actionRetry": "إعادة المحاولة",
  "@actionRetry": {
    "description": "Button that runs the failed action again, shown with errorSaveFailed."
  }
