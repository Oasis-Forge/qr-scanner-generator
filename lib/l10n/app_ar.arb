    "description": "SET-5. Value of the version row: the SemVer name followed by the build number in brackets.",
    "placeholders": {
      "version": {
        "type": "String",
        "example": "1.0.0"
      },
      "build": {
        "type": "String",
        "example": "12"
      }
    }
  },

  "themeSystemDefault": "حسب إعداد النظام",
  "@themeSystemDefault": {
    "description": "SET-1. Theme choice that follows the phone setting; the initial choice."
  },
  "themeLight": "فاتح",
  "@themeLight": {
    "description": "SET-1. Light theme choice."
  },
  "themeDark": "داكن",
  "@themeDark": {
    "description": "SET-1. Dark theme choice."
  },

  "languageSystemDefault": "حسب لغة النظام",
  "@languageSystemDefault": {
    "description": "LANG-1. Language choice that follows the device language and falls back to English. Kept apart from themeSystemDefault because languages that inflect need different wording here."
  },
  "languageEnglish": "English",
  "@languageEnglish": {
    "description": "LANG-1. English, written in its own language; the same in every message file."
